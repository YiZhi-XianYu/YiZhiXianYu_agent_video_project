{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yizhixianyu.com/contracts/workflow/workflow-definition.schema.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "required": ["definitionKey", "definitionVersion", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "definitionKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,99}$" },
    "definitionVersion": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nodeKey", "toolName", "toolVersion", "inputBinding"],
        "additionalProperties": false,
        "properties": {
          "nodeKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,99}$" },
          "toolName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "inputBinding": { "enum": ["PROJECT_ASSET", "UPSTREAM_ARTIFACT"] },
          "parameters": { "type": "object", "default": {} }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    }
  }
}
