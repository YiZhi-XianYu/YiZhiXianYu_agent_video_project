{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yizhixianyu.com/contracts/vision/person-tags.schema.json",
  "title": "Vision Person Detection Tags",
  "type": "object",
  "required": ["schemaVersion", "modelName", "sourceAssetId", "sourceShotListArtifactId", "shotCount", "shots"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "modelName": { "type": "string" },
    "sourceAssetId": { "type": "string" },
    "sourceShotListArtifactId": { "type": "string" },
    "shotCount": { "type": "integer", "minimum": 0 },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shotId", "sourceAssetId", "keyframeArtifactId", "index", "personTags"],
        "additionalProperties": false,
        "properties": {
          "shotId": { "type": "string", "pattern": "^shot_[a-f0-9]+$" },
          "sourceAssetId": { "type": "string" },
          "keyframeArtifactId": { "type": "string" },
          "index": { "type": "integer", "minimum": 0 },
          "personTags": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["label", "labelZh", "confidence"],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "enum": [
                    "NO_PERSON", "HAS_PERSON",
                    "SINGLE_PERSON", "SMALL_GROUP", "CROWD",
                    "CLOSE_UP", "FULL_BODY",
                    "WALKING", "STANDING", "SITTING", "INTERACTING"
                  ]
                },
                "labelZh": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
