# Copy this file to the repository root as .env on the server.
# Never commit the real .env file.

DEPLOY_ROOT=/opt/agent-video

# Initial IP test: http://YOUR_PUBLIC_IP
# Domain with automatic HTTPS: video.example.com
SITE_ADDRESS=http://YOUR_PUBLIC_IP

MYSQL_ROOT_PASSWORD=GENERATE_A_UNIQUE_ROOT_PASSWORD
MYSQL_APP_PASSWORD=GENERATE_A_DIFFERENT_APP_PASSWORD

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=

AUTH_SESSION_DAYS=30
# Keep false only for the initial HTTP-by-IP test. Set true with HTTPS.
AUTH_SECURE_COOKIE=false

# A 40 GB server should start with conservative upload limits.
UPLOAD_MAX_FILE_SIZE=500MB
UPLOAD_MAX_REQUEST_SIZE=1GB
ASR_MODEL_SIZE=small
