# Copy this file to the repository root as .env on the server.
# Never commit the real .env file.

DEPLOY_ROOT=/opt/agent-video

# Initial IP test: http://YOUR_PUBLIC_IP
# Domain with automatic HTTPS: video.example.com
SITE_ADDRESS=http://YOUR_PUBLIC_IP

MYSQL_ROOT_PASSWORD=GENERATE_A_UNIQUE_ROOT_PASSWORD
MYSQL_APP_PASSWORD=GENERATE_A_DIFFERENT_APP_PASSWORD

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=

AUTH_SESSION_DAYS=30
# Keep false only for the initial HTTP-by-IP test. Set true with HTTPS.
AUTH_SECURE_COOKIE=false

# A 40 GB server should start with conservative upload limits.
UPLOAD_MAX_FILE_SIZE=500MB
UPLOAD_MAX_REQUEST_SIZE=1GB
ASR_MODEL_SIZE=small

# Mainland build/model mirrors. Override for non-mainland deployments if desired.
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DOWNLOAD_TIMEOUT=300
HF_HUB_ETAG_TIMEOUT=30

# Keep light tools concurrent while serializing memory-heavy ML/render work on 8 GB hosts.
TOOL_MAX_WORKERS=4
TOOL_LIGHT_LIMIT=3
TOOL_MEDIA_LIMIT=2
TOOL_MODEL_LIMIT=1
TOOL_RENDER_LIMIT=1
# Capacity units: MODEL/RENDER=2, MEDIA=1. A value of 2 makes ML/render exclusive.
TOOL_HEAVY_LIMIT=2
TOOL_MAX_RECOVERIES=1
RELEASE_MODELS_AFTER_EXECUTION=true
