 {
   "compilerOptions": {
     "target": "ES2022",
     "module": "ESNext",
     "lib": ["ES2023"],
     "moduleResolution": "bundler",
     "strict": true,
     "noUnusedLocals": true,
     "noUnusedParameters": true,
     "noFallthroughCasesInSwitch": true,
     "skipLibCheck": true,
     "composite": true,
     "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsBuildInfo"
   },
   "include": ["vite.config.ts"]
 }
